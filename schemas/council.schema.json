{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "council",
  "type": "object",
  "properties": {
    "name": {
      "const": "The Council"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$"
    },
    "principal_investigator": {
      "const": "santiago"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "name",
    "version",
    "principal_investigator",
    "agents"
  ],
  "additionalProperties": false
}
