{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "beliefs",
  "type": "object",
  "properties": {
    "agent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "identity_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$"
    },
    "beliefs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "belief": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "revision_trigger": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "belief",
          "basis",
          "revision_trigger"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "agent",
    "identity_version",
    "beliefs"
  ],
  "additionalProperties": false
}
