{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared project objective",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "objective", "success_criteria", "constraints", "updated"],
  "properties": {
    "project": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "objective": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "success_criteria": {"type": "array", "items": {"type": "string", "pattern": "\\S"}, "uniqueItems": true},
    "constraints": {"type": "array", "items": {"type": "string", "pattern": "\\S"}, "uniqueItems": true},
    "updated": {"type": "string", "format": "date"}
  }
}
