{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "identity",
  "type": "object",
  "properties": {
    "agent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "owner": {
      "const": "santiago"
    },
    "status": {
      "const": "active"
    }
  },
  "required": [
    "agent",
    "version",
    "role",
    "owner",
    "status"
  ],
  "additionalProperties": false
}
